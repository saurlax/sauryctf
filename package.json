{
  "name": "sauryctf",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.20.0",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:dependencies": "docker compose -f compose.dev.yml up -d --wait postgres redis minio mailpit && docker compose -f compose.dev.yml run --rm minio-init",
    "dev:dependencies:down": "docker compose -f compose.dev.yml down",
    "db:migrate": "pnpm --filter sauryctf-web db:migrate",
    "dev:web": "pnpm --filter sauryctf-web dev:local",
    "dev:worker": "go run ./apps/worker/cmd/worker",
    "dev:frontend": "pnpm dev:web",
    "check:auth-redirects": "node ./scripts/check-auth-redirects.mjs",
    "check:boundaries": "node ./scripts/check-control-plane-boundaries.mjs",
    "check:jeopardy-scope": "node ./scripts/check-jeopardy-scope.mjs",
    "check:toolchain": "node ./scripts/check-toolchain.mjs",
    "test": "pnpm test:backend && pnpm test:web",
    "test:backend": "pnpm test:worker",
    "test:worker": "go test ./apps/worker/...",
    "build:worker": "go build ./apps/worker/...",
    "test:contracts": "pnpm --filter sauryctf-web test:contracts",
    "test:db": "pnpm --filter sauryctf-web exec vitest run server/infrastructure/db",
    "test:instances:lifecycle": "bash ./scripts/test-instance-lifecycle.sh",
    "test:capacity": "bash ./scripts/test-capacity-acceptance.sh",
    "test:backup-recovery": "bash ./scripts/test-backup-recovery.sh",
    "test:faults": "bash ./scripts/test-fault-recovery.sh",
    "test:security": "bash ./scripts/test-security-acceptance.sh",
    "test:web": "pnpm --filter sauryctf-web typecheck",
    "test:frontend": "pnpm test:web",
    "generate:openapi": "pnpm --filter sauryctf-web generate:openapi",
    "generate:api:frontend": "openapi-typescript api/openapi.yaml -o apps/web/app/types/control-plane-api.d.ts",
    "generate:api": "pnpm generate:openapi && pnpm generate:api:frontend",
    "build": "pnpm generate:api && pnpm --filter sauryctf-web build",
    "generate": "pnpm build",
    "typecheck": "pnpm --filter sauryctf-web typecheck"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=2.0.0 <3.0.0": "2.1.4",
      "brace-expansion@>=3.0.0 <5.0.9": "5.0.9",
      "browserslist": "4.28.7",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "nanoid@<3.3.18": "3.3.18",
      "postcss": "8.5.23",
      "postcss-selector-parser@>=7.1.0 <7.1.3": "7.1.3",
      "shell-quote": "1.9.0",
      "tar": "7.5.21"
    }
  },
  "devDependencies": {
    "openapi-typescript": "^6.7.6"
  }
}

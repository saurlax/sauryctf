{
  "name": "sauryctf",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.20.0",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "dev": "pnpm --filter sauryctf-web dev",
    "start": "node apps/web/.output/server/index.mjs",
    "build": "pnpm --filter sauryctf-web build && go build ./apps/worker/...",
    "test": "pnpm --filter sauryctf-web test && go test ./apps/worker/...",
    "check": "node ./scripts/check-toolchain.mjs && node ./scripts/check-control-plane-boundaries.mjs && node ./scripts/check-jeopardy-scope.mjs && pnpm --filter sauryctf-web check",
    "db:migrate": "pnpm --filter sauryctf-web db:migrate",
    "worker": "go run ./apps/worker/cmd/worker"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=2.0.0 <3.0.0": "2.1.4",
      "brace-expansion@>=3.0.0 <5.0.9": "5.0.9",
      "browserslist": "4.28.7",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "nanoid@<3.3.18": "3.3.18",
      "postcss": "8.5.23",
      "postcss-selector-parser@>=7.1.0 <7.1.3": "7.1.3",
      "shell-quote": "1.9.0",
      "tar": "7.5.21"
    }
  }
}

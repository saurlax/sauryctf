{
  "name": "sauryctf-web",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.20.0",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3000",
    "start": "node .output/server/index.mjs",
    "build": "nuxt build",
    "test": "vitest run",
    "check": "nuxt typecheck",
    "db:migrate": "tsx server/db/migrate-cli.ts",
    "blob:migrate": "tsx server/infrastructure/storage/blob-migrate-cli.ts",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/ui": "4.11.0",
    "@nuxthub/core": "0.10.8",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "archiver": "7.0.1",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.2",
    "h3": "1.15.11",
    "nodemailer": "9.1.1",
    "nuxt": "4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "postgres": "3.4.9",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.30",
    "vue-router": "^5.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/archiver": "7.0.0",
    "@types/nodemailer": "8.0.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "3.3.11"
  }
}

# Nuxt/Nitro control plane development dependencies
DATABASE_URL=postgresql://sauryctf:sauryctf-dev@127.0.0.1:15432/sauryctf
REDIS_URL=redis://127.0.0.1:16379/0
PUBLIC_ORIGIN=http://127.0.0.1:3000
S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_BUCKET=sauryctf
S3_ACCESS_KEY_ID=sauryctf
S3_SECRET_ACCESS_KEY=sauryctf-dev-secret
S3_FORCE_PATH_STYLE=true
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=11025
MAIL_SMTP_SECURE=false
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM=SauryCTF <noreply@sauryctf.local>
NUXT_SESSION_PASSWORD=replace-with-at-least-32-characters
# Optional: when unset, local layered rate limits remain active without Turnstile.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Go instance Worker policy
INSTANCE_LEASE_DURATION_MINUTES=30
INSTANCE_EXTENSION_DURATION_MINUTES=30
INSTANCE_RENEWAL_WINDOW_MINUTES=10
INSTANCE_TEAM_ACTIVE_LIMIT=3
INSTANCE_CLEANUP_INTERVAL_SECONDS=60

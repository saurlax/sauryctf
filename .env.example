# Nuxt/Nitro control plane development dependencies
DATABASE_URL=postgresql://sauryctf:sauryctf-dev@127.0.0.1:15432/sauryctf
REDIS_URL=redis://127.0.0.1:16379/0
PUBLIC_ORIGIN=http://127.0.0.1:3000
S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_BUCKET=sauryctf
S3_ACCESS_KEY_ID=sauryctf
S3_SECRET_ACCESS_KEY=sauryctf-dev-secret
S3_FORCE_PATH_STYLE=true
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=11025
MAIL_SMTP_SECURE=false
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM=SauryCTF <noreply@sauryctf.local>
NUXT_SESSION_PASSWORD=replace-with-at-least-32-characters
SUBMISSION_ANSWER_KEY=c2F1cnljdGYtZGV2LXN1Ym1pc3Npb24ta2V5LTAwMDE
# Optional: when unset, local layered rate limits remain active without Turnstile.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Private Go instance Worker. Use a deployment-specific login that inherits
# the NOLOGIN sauryctf_worker role created by deploy/postgres/worker-role.sql.
WORKER_ID=worker-local-1
WORKER_DATABASE_URL=postgresql://sauryctf_worker_runtime:replace-with-secret@127.0.0.1:15432/sauryctf
WORKER_DATABASE_EXPECTED_ROLE=sauryctf_worker
WORKER_DATABASE_MAX_CONNECTIONS=10
WORKER_DATABASE_CONNECT_TIMEOUT=5s
WORKER_HEALTH_ADDRESS=127.0.0.1:18081
WORKER_READINESS_TIMEOUT=2s
WORKER_SHUTDOWN_TIMEOUT=15s
